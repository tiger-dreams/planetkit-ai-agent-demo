@startuml
title AI Agent Bridge - Render Docker Runtime\nPlanetKit Conference + Gemini 3.8 Live
' Historical filename retained for compatibility: architecture-ai-agent-windows-vm.puml
' Public repository: Selenium Docker runtime is provided separately.
' Source: https://github.com/tiger-dreams/viva-connect-test/tree/main/render-service
left to right direction
skinparam componentStyle rectangle
skinparam packageStyle frame
skinparam defaultFontSize 12

package "Client browser / LINE LIFF" {
  component "Meeting UI\nAI invite / mode controls" as Meeting
  component "User PlanetKit participant" as User
}
package "Vercel" {
  component "Frontend\n/headless-agent" as Frontend
  component "POST /api/ai-agent-session\nGEMINI_API_KEY environment" as SessionAPI
}
package "Render - Docker / Linux" {
  component "start-xvfb.sh\nXvfb + PulseAudio" as Startup
  component "Supervisor\nserver-selenium.js" as Service
  package "Chrome on Xvfb\nSelenium WebDriver; no --headless flag" {
    component "HeadlessAgentPage\nPlanetKit participant" as Agent
    component "AI service + Gemini provider\nListen / respond output gate" as Provider
    component "AudioWorklet\nPCM16 16 kHz" as Worklet
    component "AudioContext\nMediaStreamDestination" as Output
  }
}
cloud "LINE Planet\nConference media / signaling" as Planet
cloud "Google Gemini 3.8 Live\nWebSocket" as Gemini

Meeting --> Service : POST /join-as-agent\nVITE_RENDER_SERVICE_URL
Service --> Meeting : 202 Accepted\nbrowser startup scheduled
Startup --> Service : start supervised service
Service --> Agent : launch Chrome / load agent URL
Frontend ..> Agent : page from FRONTEND_URL
Agent --> SessionAPI : request provider configuration
SessionAPI --> Provider : model / WS endpoint / API key
User <--> Planet : WebRTC conference media
Agent <--> Planet : WebRTC / same service and room
Agent --> Worklet : captureStream() / room audio
Worklet --> Gemini : PCM16 input / WebSocket
Gemini --> Provider : audio response / 24 kHz
Provider --> Output : respond mode audio
Output --> Agent : setCustomMediaStream()
Meeting --> Service : POST /agent-mode\nPOST /disconnect-agent
Service --> Provider : execute mode control in page

note bottom of Service
  202 means accepted, not media-ready.
  Confirm the AI peer through PlanetKit
  evtPeerListUpdated, then test two-way audio.
end note
note bottom of SessionAPI
  Provider key is configured on Vercel.
  Current demo returns the Gemini key to the browser;
  review access and credential handling before public use.
end note
note bottom of Provider
  PlanetKit transports conference media.
  Gemini provides AI voice responses.
  Listen mode gates AI output while retaining audio input.
end note
@enduml
